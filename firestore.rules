rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'displayName', 'role', 'disabled']) &&
             data.id is string && isValidId(data.id) &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.role in ['admin', 'friend'] &&
             data.disabled is bool &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 100)) &&
             (!('online' in data) || (data.online is bool));
    }

    function isValidDevice(data) {
      return data.keys().hasAll(['id', 'userId', 'deviceName', 'deviceType', 'createdAt', 'lastActive']) &&
             data.id is string && isValidId(data.id) &&
             data.userId is string && isValidId(data.userId) &&
             data.deviceName is string && data.deviceName.size() <= 100 &&
             data.deviceType in ['desktop', 'mobile', 'tablet', 'browser'];
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'senderId', 'receiverId', 'text', 'status', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.receiverId is string && isValidId(data.receiverId) &&
             data.text is string && data.text.size() <= 5000 &&
             data.status in ['sent', 'delivered', 'read'] &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 1000)) &&
             (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 255));
    }

    function isValidReport(data) {
      return data.keys().hasAll(['id', 'messageId', 'reportedBy', 'reportedUserId', 'reason', 'status', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.messageId is string && isValidId(data.messageId) &&
             data.reportedBy is string && isValidId(data.reportedBy) &&
             data.reportedUserId is string && isValidId(data.reportedUserId) &&
             data.reason is string && data.reason.size() <= 500 &&
             data.status in ['pending', 'resolved'];
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                    isValidId(userId) &&
                    (request.auth.uid == userId || isAdmin()) &&
                    isValidUser(incoming()) &&
                    (incoming().role == 'friend' || isAdmin()) &&
                    (incoming().disabled == false || isAdmin());

      allow update: if isSignedIn() &&
                    isValidId(userId) &&
                    isValidUser(incoming()) &&
                    (
                      isAdmin() ||
                      (
                        isOwner(userId) &&
                        incoming().id == existing().id &&
                        incoming().role == existing().role &&
                        incoming().disabled == existing().disabled &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'bio', 'status', 'online', 'lastSeen'])
                      )
                    );

      allow delete: if isAdmin() && isValidId(userId);

      // LINKED DEVICES SUBCOLLECTION
      match /devices/{deviceId} {
        allow get, list: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
        allow create, update: if isSignedIn() && isValidId(userId) && isValidId(deviceId) &&
                              (request.auth.uid == userId || isAdmin()) &&
                              isValidDevice(incoming()) && incoming().userId == userId;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(deviceId) &&
                      (request.auth.uid == userId || isAdmin());
      }
    }

    // MESSAGES COLLECTION
    match /messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) &&
                 (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid || isAdmin());

      allow list: if isSignedIn() &&
                  (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                    isValidId(messageId) &&
                    isValidMessage(incoming()) &&
                    incoming().senderId == request.auth.uid &&
                    incoming().id == messageId;

      allow update: if isSignedIn() &&
                    isValidId(messageId) &&
                    isValidMessage(incoming()) &&
                    (
                      isAdmin() ||
                      (
                        // Sender edit
                        existing().senderId == request.auth.uid &&
                        incoming().senderId == existing().senderId &&
                        incoming().receiverId == existing().receiverId &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt', 'isDeleted', 'reactions'])
                      ) ||
                      (
                        // Receiver status update or reaction
                        existing().receiverId == request.auth.uid &&
                        incoming().senderId == existing().senderId &&
                        incoming().receiverId == existing().receiverId &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().text == existing().text &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reactions'])
                      )
                    );

      allow delete: if isSignedIn() && isValidId(messageId) &&
                    (isAdmin() || existing().senderId == request.auth.uid);
    }

    // REPORTS COLLECTION
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                    isValidId(reportId) &&
                    isValidReport(incoming()) &&
                    incoming().reportedBy == request.auth.uid;
      allow update: if isValidId(reportId) && isAdmin() && isValidReport(incoming());
      allow delete: if isValidId(reportId) && isAdmin();
    }

    // ADMINS LOOKUP
    match /admins/{adminId} {
      allow read: if isSignedIn() && isValidId(adminId);
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
